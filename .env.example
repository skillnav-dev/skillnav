# Supabase (required for database features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts only — NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Admin console login (required for /admin)
ADMIN_PASSWORD=
# Optional: separate HMAC key for admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# GitHub personal access token (optional, increases rate limit from 60/hr to 5000/hr)
GITHUB_TOKEN=

# Anthropic API key (for AI translation pipeline)
ANTHROPIC_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
